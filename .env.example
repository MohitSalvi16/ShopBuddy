# ---------- Server ----------
# Product / assistant name (spoken in greetings). Also update client/src/brand.ts.
APP_NAME=ShopBuddy
PORT=4000
# Public HTTPS URL of this backend that Agora's cloud can reach (e.g. an ngrok/cloudflared tunnel to :4000).
# Agora ConvoAI calls  ${PUBLIC_BASE_URL}/api/llm/chat/completions  as its custom LLM.
PUBLIC_BASE_URL=

# ---------- Agora (Console > Project) ----------
AGORA_APP_ID=
# Required if the project has App Certificate enabled (recommended). Used for RTC tokens.
AGORA_APP_CERTIFICATE=
# Console > RESTful API > Customer ID / Secret (Basic auth for the ConvoAI REST API).
# If omitted, the server uses `Authorization: agora token=...` with a ConvoAI token (needs AGORA_APP_CERTIFICATE).
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ---------- Speech-to-text used by the Agora agent ----------
# Default: Agora ARES ASR. Set ASR_VENDOR=deepgram + STT_API_KEY to use Deepgram nova-3 (language "multi" for Hinglish).
ASR_VENDOR=ares
ASR_LANGUAGE=en-IN
STT_API_KEY=
# Escape hatch: full JSON for properties.asr, e.g. {"vendor":"microsoft","params":{...}}
ASR_JSON=

# ---------- Murf Falcon TTS ----------
MURF_API_KEY=
# Falcon voices for Indian English / Hindi (see Murf voice library): Anisha, Priya, Aarav, Samar, Pooja, Nikhil...
MURF_VOICE_ID=Anisha
MURF_LOCALE=en-IN
MURF_MODEL=FALCON
# Voice for Devanagari (Hindi) replies in Lite voice mode. Anisha + hi-IN verified working.
MURF_HINDI_VOICE_ID=Anisha
MURF_HINDI_LOCALE=hi-IN

# ---------- LLM (OpenAI-compatible chat completions with tool calling) ----------
# gemini | openai   (leave LLM_API_KEY empty to use the built-in deterministic rule engine)
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional overrides (default for gemini: gemini-3.5-flash-lite — fast tool calling; gemini-2.5-* is closed to new keys)
LLM_MODEL=
LLM_BASE_URL=
# Random string; Agora sends it as "Authorization: Bearer <secret>" to the custom LLM endpoint.
LLM_PROXY_SECRET=change-me-to-a-random-string
